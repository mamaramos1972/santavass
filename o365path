# ============================================================
# DIAGNOSTICO COMPLETO MICROSOFT 365 APPS
# Proxy + conectividad + Office + licencia + token
# PowerShell 5.1
# SOLO SALIDA POR PANTALLA
# ============================================================

$ErrorActionPreference = "SilentlyContinue"
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

Clear-Host

Write-Host "============================================================" -ForegroundColor Cyan
Write-Host "     DIAGNOSTICO MICROSOFT 365 APPS / ACTIVACION" -ForegroundColor Cyan
Write-Host "============================================================" -ForegroundColor Cyan
Write-Host ""

# ------------------------------------------------------------
# SERVIDOR
# ------------------------------------------------------------

Write-Host "[ SERVIDOR ]" -ForegroundColor Yellow

$OS = Get-CimInstance Win32_OperatingSystem

Write-Host "Equipo       : $env:COMPUTERNAME"
Write-Host "Usuario      : $env:USERDOMAIN\$env:USERNAME"
Write-Host "Sistema      : $($OS.Caption)"
Write-Host "Arquitectura : $($OS.OSArchitecture)"
Write-Host ""

# ------------------------------------------------------------
# PROXY WINHTTP
# ------------------------------------------------------------

Write-Host "[ PROXY WINHTTP ]" -ForegroundColor Yellow
netsh winhttp show proxy
Write-Host ""

# ------------------------------------------------------------
# PROXY WININET
# ------------------------------------------------------------

Write-Host "[ PROXY WININET ]" -ForegroundColor Yellow

$Internet = Get-ItemProperty `
    "HKCU:\Software\Microsoft\Windows\CurrentVersion\Internet Settings"

if ($Internet.ProxyEnable -eq 1) {
    Write-Host "Estado : HABILITADO" -ForegroundColor Green
    Write-Host "Proxy  : $($Internet.ProxyServer)"
}
else {
    Write-Host "Estado : DESHABILITADO" -ForegroundColor Yellow
}

Write-Host ""

# ------------------------------------------------------------
# SERVICIO CLICK-TO-RUN
# ------------------------------------------------------------

Write-Host "[ OFFICE CLICK-TO-RUN ]" -ForegroundColor Yellow

$C2R = Get-Service ClickToRunSvc

if ($C2R) {
    Write-Host "Servicio : $($C2R.Status)"
    Write-Host "Inicio   : $($C2R.StartType)"

    if ($C2R.Status -eq "Running") {
        Write-Host "Resultado: OK" -ForegroundColor Green
    }
    else {
        Write-Host "Resultado: ERROR" -ForegroundColor Red
    }
}
else {
    Write-Host "ClickToRunSvc no encontrado" -ForegroundColor Red
}

Write-Host ""

# ------------------------------------------------------------
# CONFIGURACION CLICK-TO-RUN
# ------------------------------------------------------------

Write-Host "[ CONFIGURACION OFFICE ]" -ForegroundColor Yellow

$C2RPaths = @(
    "HKLM:\SOFTWARE\Microsoft\Office\ClickToRun\Configuration",
    "HKLM:\SOFTWARE\WOW6432Node\Microsoft\Office\ClickToRun\Configuration"
)

$C2RConfig = $null

foreach ($Path in $C2RPaths) {
    if (Test-Path $Path) {
        $C2RConfig = Get-ItemProperty $Path
        break
    }
}

if ($C2RConfig) {

    Write-Host "ProductReleaseIds       : $($C2RConfig.ProductReleaseIds)"
    Write-Host "ClientVersionToRun      : $($C2RConfig.ClientVersionToRun)"
    Write-Host "Platform                : $($C2RConfig.Platform)"
    Write-Host "UpdateChannel           : $($C2RConfig.UpdateChannel)"
    Write-Host "CDNBaseUrl              : $($C2RConfig.CDNBaseUrl)"
    Write-Host "SharedComputerLicensing : $($C2RConfig.SharedComputerLicensing)"
    Write-Host "DeviceBasedLicensing    : $($C2RConfig.O365ProPlusRetailDeviceBasedLicensing)"
    Write-Host "SCLCacheOverride        : $($C2RConfig.SCLCacheOverride)"
}
else {
    Write-Host "Configuración Click-to-Run no encontrada" -ForegroundColor Red
}

Write-Host ""

# ------------------------------------------------------------
# ENDPOINTS UTILIZADOS POR LICENCIA M365
# ------------------------------------------------------------

Write-Host "[ ENDPOINTS DE LICENCIA MICROSOFT 365 ]" -ForegroundColor Yellow
Write-Host ""

$Endpoints = @(
    "ols.officeapps.live.com",
    "activation.sls.microsoft.com",
    "login.microsoftonline.com",
    "login.windows.net",
    "officeclient.microsoft.com",
    "config.office.com",
    "graph.microsoft.com"
)

foreach ($HostName in $Endpoints) {

    Write-Host "------------------------------------------------------------"
    Write-Host $HostName -ForegroundColor Cyan

    # DNS
    try {
        $DNS = Resolve-DnsName $HostName -Type A -ErrorAction Stop

        $IP = ($DNS |
            Where-Object {$_.IPAddress} |
            Select-Object -First 1 -ExpandProperty IPAddress)

        Write-Host "DNS       : OK ($IP)" -ForegroundColor Green
    }
    catch {
        Write-Host "DNS       : ERROR" -ForegroundColor Red
    }

    # TCP
    try {
        $TCP = Test-NetConnection `
            -ComputerName $HostName `
            -Port 443 `
            -WarningAction SilentlyContinue

        if ($TCP.TcpTestSucceeded) {
            Write-Host "TCP 443   : OK" -ForegroundColor Green
        }
        else {
            Write-Host "TCP 443   : ERROR" -ForegroundColor Red
        }
    }
    catch {
        Write-Host "TCP 443   : ERROR" -ForegroundColor Red
    }

    # HTTPS
    try {

        $R = Invoke-WebRequest `
            -Uri "https://$HostName" `
            -UseBasicParsing `
            -TimeoutSec 15 `
            -ErrorAction Stop

        Write-Host "HTTPS     : OK ($($R.StatusCode))" -ForegroundColor Green
    }
    catch {

        Write-Host "HTTPS     : ERROR" -ForegroundColor Red
        Write-Host "  $($_.Exception.Message)" -ForegroundColor DarkRed
    }
}

Write-Host ""

# ------------------------------------------------------------
# VNEXTDIAG
# ------------------------------------------------------------

Write-Host "[ LICENCIA VNEXT - MICROSOFT 365 APPS ]" -ForegroundColor Yellow
Write-Host ""

$VNextPaths = @(
    "$env:ProgramFiles\Microsoft Office\root\Licenses16\vnextdiag.ps1",
    "${env:ProgramFiles(x86)}\Microsoft Office\root\Licenses16\vnextdiag.ps1",
    "$env:ProgramFiles\Microsoft Office\root\Licenses16\vnextdiag.ps1"
)

$VNext = $VNextPaths |
    Where-Object { Test-Path $_ } |
    Select-Object -First 1

if ($VNext) {

    Write-Host "vnextdiag : $VNext" -ForegroundColor Green
    Write-Host ""

    try {

        $Diag = & powershell.exe `
            -NoProfile `
            -ExecutionPolicy Bypass `
            -File $VNext `
            -action list 2>&1

        if ($Diag) {
            $Diag | ForEach-Object {
                Write-Host $_
            }
        }
        else {
            Write-Host "vnextdiag no devuelve información" -ForegroundColor Red
        }
    }
    catch {
        Write-Host $_.Exception.Message -ForegroundColor Red
    }

}
else {

    Write-Host "vnextdiag.ps1 NO encontrado" -ForegroundColor Red
}

Write-Host ""

# ------------------------------------------------------------
# TOKENS OFFICE
# ------------------------------------------------------------

Write-Host "[ TOKENS / CACHE DE LICENCIA ]" -ForegroundColor Yellow
Write-Host ""

$TokenPaths = @(
    "$env:LOCALAPPDATA\Microsoft\Office\16.0\Licensing",
    "$env:LOCALAPPDATA\Microsoft\Office\Licenses",
    "$env:LOCALAPPDATA\Microsoft\Office\16.0\Identity",
    "$env:LOCALAPPDATA\Microsoft\Office\16.0\Identity\IdentityCRL"
)

$TokenEncontrado = $false

foreach ($Path in $TokenPaths) {

    if (Test-Path $Path) {

        $Items = Get-ChildItem `
            $Path `
            -Recurse `
            -Force `
            -ErrorAction SilentlyContinue

        if ($Items) {

            $TokenEncontrado = $true

            Write-Host "ENCONTRADO : $Path" -ForegroundColor Green
            Write-Host "Elementos  : $($Items.Count)"
        }
    }
}

if (-not $TokenEncontrado) {
    Write-Host "NO SE ENCUENTRAN TOKENS/CACHE" -ForegroundColor Red
}

Write-Host ""

# ------------------------------------------------------------
# REGISTRO IDENTIDAD OFFICE
# ------------------------------------------------------------

Write-Host "[ IDENTIDAD OFFICE ]" -ForegroundColor Yellow
Write-Host ""

$Identity = "HKCU:\Software\Microsoft\Office\16.0\Common\Identity"

if (Test-Path $Identity) {

    Get-ItemProperty $Identity |
        Select-Object * |
        Format-List
}
else {

    Write-Host "No existe la clave de identidad" -ForegroundColor Red
}

Write-Host ""

# ------------------------------------------------------------
# CREDENCIALES RELACIONADAS CON OFFICE
# ------------------------------------------------------------

Write-Host "[ CREDENCIALES ]" -ForegroundColor Yellow
Write-Host ""

$Creds = cmdkey /list 2>&1 |
    Select-String "MicrosoftOffice|Office16|ADAL|AzureAD|OneAuth"

if ($Creds) {

    Write-Host "Se han encontrado credenciales relacionadas:" -ForegroundColor Green

    $Creds | ForEach-Object {
        Write-Host "  $($_.Line.Trim())"
    }
}
else {

    Write-Host "No se han encontrado credenciales relacionadas" -ForegroundColor Yellow
}

Write-Host ""

# ------------------------------------------------------------
# OFFICE INSTALADO
# ------------------------------------------------------------

Write-Host "[ PRODUCTOS OFFICE INSTALADOS ]" -ForegroundColor Yellow
Write-Host ""

$UninstallPaths = @(
    "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\*",
    "HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*"
)

$OfficeProducts = foreach ($Path in $UninstallPaths) {

    Get-ItemProperty $Path |
        Where-Object {
            $_.DisplayName -match "Microsoft 365|Microsoft Office|Office 365"
        } |
        Select-Object DisplayName,DisplayVersion
}

if ($OfficeProducts) {

    $OfficeProducts |
        Sort-Object DisplayName -Unique |
        Format-Table -AutoSize
}
else {

    Write-Host "No se ha localizado producto Office en el registro" -ForegroundColor Red
}

Write-Host ""

# ------------------------------------------------------------
# FINAL
# ------------------------------------------------------------

Write-Host "============================================================" -ForegroundColor Cyan
Write-Host "                 FIN DEL DIAGNOSTICO" -ForegroundColor Cyan
Write-Host "============================================================" -ForegroundColor Cyan
